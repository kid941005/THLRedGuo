# Copy to .env and set GW_BIND=0.0.0.0 for trusted LAN access.
GW_TAG=latest
GW_BIND=127.0.0.1
GW_PORT=8080
CACHE_TTL_MIN=180
CACHE_MAX_MB=2048
CACHE_SWEEP_SEC=300
CACHE_MAX_FILES=0
MEDIA_CONCURRENCY=2
HG_TRANSCODE=0
PLAYBACK_IDENTITY_TTL_HOURS=720
# For HTTPS reverse proxies, set the exact external origin and enable secure cookies.
PUBLIC_ORIGIN=
COOKIE_SECURE=0
# Optional fixed first-run setup token; leave empty to generate /app/data/setup-token.
SETUP_TOKEN=
DOWNLOAD_MAX_MB=10240
DOWNLOAD_CONCURRENCY=2
TZ=Asia/Shanghai
